rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'ADMIN';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // users
    // ------------------------------------------------------------------
    match /users/{userId} {
      // Perfis sao carregados pela aplicacao para exibir o responsavel
      // das tarefas em telas compartilhadas.
      allow read: if isSignedIn();

      allow create: if isAdmin() || isOwner(userId);

      // O proprio usuario atualiza o seu perfil; ADMIN atualiza qualquer um.
      allow update: if isAdmin() || isOwner(userId);

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // tasks
    // ------------------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn();

      allow update: if isSignedIn();

      allow delete: if isAdmin() || isOwner(resource.data.userId);
    }

    // ------------------------------------------------------------------
    // internal — conteudo administrativo do desafio (rota /gabarito)
    //
    // Leitura e escrita liberadas exclusivamente para a conta responsavel
    // pelo desafio. O e-mail abaixo e mantido por `npm run gabarito:publish`
    // a partir de GABARITO_OWNER_EMAIL, mas pode ser editado a mao.
    //
    // A escrita e permitida para que o gabarito possa ser publicado pelo
    // `npm run setup:remote`, que usa o SDK cliente e dispensa uma service
    // account. Nenhuma outra conta le nem escreve nesta colecao.
    // ------------------------------------------------------------------
    function isOwnerAccount() {
      return isSignedIn() && request.auth.token.email == 'rayansl0302@gmail.com';
    }

    match /internal/{docId} {
      allow read: if isOwnerAccount();
      allow write: if isOwnerAccount();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
