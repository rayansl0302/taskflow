# ---------------------------------------------------------------
# TaskFlow - variaveis de ambiente
# Copie este arquivo para .env e ajuste conforme o seu ambiente.
# ---------------------------------------------------------------

# Credenciais do projeto Firebase (Console > Configuracoes do projeto)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=taskflow-qa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=taskflow-qa
VITE_FIREBASE_STORAGE_BUCKET=taskflow-qa.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Usa o Firebase Emulator Suite (recomendado para desenvolvimento/QA)
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080

# Senha padrao aplicada pelo seed aos usuarios de demonstracao
VITE_SEED_PASSWORD=Taskflow@2024

# Rota interna /gabarito — conta autorizada a ler o documento em internal/qa-gabarito.
# Use um e-mail diferente das credenciais entregues ao QA.
GABARITO_OWNER_EMAIL=
GABARITO_OWNER_PASSWORD=
GABARITO_DATA=./docs/gabarito.json
